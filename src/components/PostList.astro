---
import type { CollectionEntry } from 'astro:content';
import { formatDate, isPublished } from '../lib/post-utils';
interface Props { posts: CollectionEntry<'blog'>[] }
const { posts } = Astro.props;
---
<ul class="post-list">
  {posts.map((post) => <li>
    <a class="post-link" href={`/blog/${post.id}/`}>
      <div class="post-title-row">
        <h3>{post.data.title} <span class="post-arrow" aria-hidden="true">↗</span></h3>
        <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time>
      </div>
      <p>{post.data.description}</p>
      {!isPublished(post.data) && <span class="preview-badge">{post.data.draft ? 'Draft' : 'Scheduled'} · Local preview only</span>}
    </a>
  </li>)}
</ul>
